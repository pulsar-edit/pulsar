'scopeName': 'source.xs'
'name': 'Perl XS'
'fileTypes': [
  'xs'
]
'patterns': [
  {
    'name': 'keyword.control.directive.xs',
    'match': '\\s*#\\b(define|include|if|ifdef|ifndef|elif|elifdef|elifndef|endif|error|warning|pragma|line)\\b'
  }
  {
    # Hash style comments are only allowed if a whitespace precedes them in XS
    'name': 'comment.line.number-sign.xs'
    'match': '\\s+#.*$'
  }
  {
    'name': 'comment.block.xs'
    'begin': '/\\*'
    'end': '\\*/'
  }
  {
    'name': 'keyword.control.directive.xs'
    'match': '\\b(PROTOTYPES|BOOT|REQUIRE|INCLUDE|PREINIT|INIT|MODULE|PACKAGE)\\b'
  }
  {
    'name': 'keyword.other.xs'
    'match': '\\b(CODE|INIT|PPCODE|INPUT|OUTPUT|CLEANUP|ALIAS|ATMS|NO_INIT)\\b'
  }
  {
    'name': 'entity.name.function.xs'
    'match': '\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()'
  }
  {
    'name': 'storage.type.c.xs'
    'match': '\\b(constexpr|consteval|constinit|const|asm|__asm__|auto|bool|_Bool|char|_Complex|double|enum|float|_Imaginary|int|long|short|signed|struct|typedef|union|unsigned|void|SV|AV|HV|IV|UV|CV|GV|SVref|HVref)\\b'
  }
  {
    'match': '\\b(NULL|nullptr|true|false|TRUE|FALSE)\\b'
    'name': 'constant.language.c.xs'
  }
  {
    'name': 'string.quoted.double.xs'
    'begin': '"'
    'end': '"'
    'patterns': [
      {
        'name': 'constant.character.escape.xs'
        'match': '\\\\.'
      }
    ]
  }
  {
    'name': 'string.quoted.single.xs'
    'begin': "'"
    'end': "'"
    'patterns': [
      {
        'name': 'constant.character.escape.xs'
        'match': '\\\\.'
      }
    ]
  }
  {
    'name': 'constant.numeric.xs'
    'match': '\\b-?[0-9]+(\\.[0-9]+)?\\b'
  }
  {
    'begin': '\\b(CODE|PPCODE)\\b\\s*:'
    'end': '(?=\\b(OUTPUT|CLEANUP|CODE|PPCODE):?\\b|$)'
    'patterns': [
      {
        'include': 'source.c'
      }
    ]
  }
]
